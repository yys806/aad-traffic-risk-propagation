name: project-integrity

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip
          cache-dependency-path: code/pyproject.toml
      - name: Validate tracked project knowledge and evidence
        run: |
          python code/scripts/validate_project_docs.py --strict-git --require-clean
          python code/scripts/export_project_evidence.py --repo-root . --verify
      - name: Install development dependencies
        run: python -m pip install -e "./code[dev]"
      - name: Run project-document contract tests
        run: python -m pytest code/tests/test_project_docs.py -q
