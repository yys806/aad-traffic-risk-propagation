# latexmk 配置：XeLaTeX + biber（参考文献走 biblatex/gb7714-2025）
# 轮数不设上限：从零开始要 xelatex → biber → xelatex → xelatex 才稳定。
$pdf_mode  = 5;      # 5 = xelatex（中文必须用它，pdfLaTeX 排不了）
$bibtex_use = 2;     # 允许 bibtex/biber，并自动重跑
$biber     = 'biber %O %S';

$clean_ext = 'bbl glo gls hd loa run.xml thm xdv aux bcf fdb_latexmk fls out synctex.gz toc vrb';
